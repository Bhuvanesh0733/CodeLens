# CodeLens Server — Environment Variables

# ─────────────────────────────────────────────────────────────────
#  REQUIRED: Add your Anthropic API key here
#  Get one at: https://console.anthropic.com/
# ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_api_key_here

# Server port (optional, defaults to 3001)
PORT=3001
